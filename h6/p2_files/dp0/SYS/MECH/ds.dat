        5     1.000000000E+01     0.000000000E+00     4.000000000E+00
        6     2.000000000E+00     0.000000000E+00     4.000000000E+00
        7     6.000000000E+00     0.000000000E+00     4.000000000E+00
-1
/wb,elem,start            !  set before creation of elements
/com,*********** Elements for Body 1 "Line Body" ***********
et,1,188
keyo,1,3,2
eblock,19,solid,,3
(19i9)
        1        1        1        1        0        0        0        0        3        0        1        1        2        5
        1        1        1        1        0        0        0        0        3        0        2        3        4        6
